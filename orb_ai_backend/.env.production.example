# Production configuration template. Replace every REPLACE_ME value; never commit .env.
APP_ENV=production
APP_NAME=ORB AI
APP_VERSION=1.2.3
API_V1_PREFIX=/api/v1
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database and Docker Compose inputs
POSTGRES_USER=REPLACE_ME_DB_USER
POSTGRES_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=orb_ai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://REPLACE_ME_DB_USER:REPLACE_ME_STRONG_DB_PASSWORD@postgres:5432/orb_ai

# Redis (Compose config derives REDIS_URL from REDIS_PASSWORD)
REDIS_PASSWORD=REPLACE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
REDIS_ENABLED=true
REDIS_HOST_PORT=6379

# Authentication and encrypted broker credentials. Generate independent keys.
JWT_SECRET_KEY=REPLACE_ME_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY
ADMIN_SEED_ON_STARTUP=true
ADMIN_SEED_EMAIL=REPLACE_ME_ADMIN_EMAIL
ADMIN_SEED_PASSWORD=REPLACE_ME_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
ADMIN_SEED_FULL_NAME=ORB Admin

# Browser origins, comma-separated (no wildcard in production)
CORS_ORIGINS=https://admin.example.com,https://app.example.com
ADMIN_UI_DIST=/app/admin_web_dist

# Logging and monitoring
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/orb_ai/app.log
LOG_FILE_MAX_BYTES=20971520
LOG_FILE_BACKUP_COUNT=10
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_ENABLED=true
SECURITY_CSP=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=240
RATE_LIMIT_EXEMPT_PATHS=["/health","/api/v1/health","/api/admin-ui","/docs","/redoc","/openapi.json","/api/v1/monitoring/metrics/prometheus"]
SLOW_REQUEST_THRESHOLD_MS=1500

# Trading session and market data. Select a real provider for production.
MARKET_DATA_PROVIDER=dhan
DHAN_CLIENT_ID=REPLACE_ME_DHAN_CLIENT_ID
DHAN_ACCESS_TOKEN=REPLACE_ME_DHAN_ACCESS_TOKEN
UPSTOX_ENABLED=false
UPSTOX_ACCESS_TOKEN=
UPSTOX_ANALYTICS_TOKEN=
MOCK_TICK_INTERVAL_MS=250
MOCK_RANDOM_SEED=42
TRADING_SESSION_START=09:15
TRADING_SESSION_END=15:30
TRADING_SESSION_TIMEZONE=Asia/Kolkata
TRADING_MODE_LIVE_COOLDOWN_SECONDS=60
TRADING_MODE_AUTO_REVERT_CRON=*/5 * * * *

# Notifications (configure the provider(s) in use)
RESEND_API_KEY=REPLACE_ME_RESEND_API_KEY
RESEND_FROM_EMAIL=ORB AI <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMERGENT_PUSH_ENABLED=false
EMERGENT_PUSH_ENDPOINT=
EMERGENT_PUSH_API_KEY=
NOTIFICATIONS_ASYNC=true
NOTIFICATIONS_MAX_RETRIES=3

# Reports, analytics, and scheduled jobs
REPORTS_MAX_ROWS=50000
REPORTS_COMPANY_NAME=ORB AI
REPORTS_COMPANY_TAGLINE=Algorithmic Trading Platform
ANALYTICS_CACHE_TTL_SECONDS=30
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_SNAPSHOT_CRON=0 18 * * *
SCHEDULER_WEEKLY_DIGEST_CRON=0 6 * * MON
SCHEDULER_NOTIFICATION_RETRY_CRON=*/5 * * * *

# Billing: select razorpay or stripe and provide its live API + webhook keys.
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=REPLACE_ME_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_ME_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_SUCCESS_URL=https://app.example.com/billing/success
RAZORPAY_CANCEL_URL=https://app.example.com/billing/cancel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://app.example.com/billing/success
STRIPE_CANCEL_URL=https://app.example.com/billing/cancel
MOCK_BILLING_SECRET=UNUSED_IN_PRODUCTION

# AI features (optional; provider key needed for hosted LLMs)
AI_ENABLED=true
AI_PROVIDER=rule_based
AI_MODEL=gpt-5.2
# AI_TEMPERATURE=<provider default>  # optional numeric override; leave unset by default
# AI_MAX_TOKENS=<provider default>   # optional integer override; leave unset by default
EMERGENT_LLM_KEY=
AI_CACHE_TTL_S=600
AI_REQUEST_TIMEOUT_S=25

# Execution safety defaults; retain conservative code defaults unless reviewed.
EXEC_TRADES_PER_SECOND=8
EXEC_ORDERS_PER_MINUTE=100
EXEC_ORDERS_PER_HOUR=2000
EXEC_GLOBAL_ORDERS_PER_SECOND=200
EXEC_GLOBAL_ORDERS_PER_MINUTE=5000
EXEC_DUPLICATE_WINDOW_SECONDS=1
EXEC_DUPLICATE_ACTION=reject
EXEC_QUEUE_ENABLED=true
EXEC_QUEUE_MAX_SIZE=500
EXEC_QUEUE_TIMEOUT_SECONDS=30
EXEC_AUTO_PAUSE_ENABLED=true
EXEC_AUTO_PAUSE_VIOLATIONS=10
EXEC_AUTO_PAUSE_WINDOW_SECONDS=60
EXEC_EVENT_RETENTION_DAYS=90
RISK_BREACH_RETENTION_DAYS=90
RISK_RETENTION_CRON=0 4 * * *

# Backups (optional; S3 credentials are needed only when enabled)
BACKUP_ENABLED=false
BACKUP_LOCAL_DIR=/var/backups/orb_ai
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_CRON=0 3 * * *
BACKUP_S3_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=postgres
BACKUP_ENCRYPTION_KEY=

# Deployment metadata consumed by Compose/Railway
API_HOST_PORT=8000
IMAGE_TAG=1.2.3
